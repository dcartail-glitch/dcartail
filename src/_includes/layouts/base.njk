<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{ title or "d'Cartail - Ceramic Coating & Detailing Mobil Jakarta Selatan" }}</title>
  <meta name="description" content="{{ description or "d'Cartail adalah premium auto detailing studio & spesialis nano ceramic coating mobil di Jakarta Selatan." }}" />
  <link rel="canonical" href="https://dcartail.pages.dev{{ page.url }}" />
  <meta name="google-site-verification" content="3mWgaa711MF4CFI-LfRs3fcYTMIUIPRYTcjt6XEBDyg" />
  
  <!-- Open Graph -->
  <meta property="og:title" content="{{ title or "d'Cartail" }}" />
  <meta property="og:description" content="{{ description or "Premium auto detailing & ceramic coating Jakarta Selatan." }}" />
  <meta property="og:url" content="https://dcartail.pages.dev{{ page.url }}" />
  <meta property="og:type" content="website" />
  <meta property="og:image" content="https://dcartail.pages.dev/assets/logo.png" />
  
  <link rel="stylesheet" href="/style.css" />

  {% if schema %}
  <script type="application/ld+json">
  {{ schema | safe }}
  </script>
  {% endif %}

<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-B5YZMFE4X5"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-B5YZMFE4X5');
</script>

<script>
  // Track klik WhatsApp
  document.addEventListener('DOMContentLoaded', function() {
    document.querySelectorAll('a[href*="wa.me"]').forEach(function(link) {
      link.addEventListener('click', function() {
        gtag('event', 'whatsapp_click', {
          'event_category': 'engagement',
          'event_label': 'WhatsApp Button',
          'value': 1
        });
      });
    });
  });
</script>

</head>
<body>
  <a class="floating-wa" href="https://wa.me/6281935683186?text=Halo%2C%20saya%20ingin%20konsultasi%20pengerjaan%20di%20d%27Cartail." target="_blank">WhatsApp</a>

  {{ content | safe }}

  <footer>
    <p>d'Cartail Premium Car Care Service</p>
    <p>Jl. Radio Dalam Raya 18 • @dcartail • 0819 3568 3186</p>
  </footer>

  <script src="/script.js"></script>
</body>
</html>
